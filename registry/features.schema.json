{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dev-suite feature registry",
  "type": "object",
  "required": ["schemaVersion", "features"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "features": {
      "type": "array",
      "items": { "$ref": "#/definitions/feature" }
    },
    "promptTemplates": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "feature": {
      "type": "object",
      "required": ["id", "version", "type", "name", "description", "addedInVersion", "apply"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "version": { "type": "string" },
        "type": { "type": "string", "enum": ["hook", "agent-update"] },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "addedInVersion": { "type": "string" },
        "stackRequirements": {
          "type": "object",
          "properties": {
            "requiresAny": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "requiresPackage": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        },
        "dependencies": {
          "type": "object",
          "properties": {
            "agents": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        },
        "apply": {
          "type": "object",
          "required": ["type", "target"],
          "properties": {
            "type": { "type": "string", "enum": ["hook-merge", "agent-replace"] },
            "target": { "type": "string" },
            "source": { "type": "string" },
            "event": { "type": "string" },
            "config": { "type": "object" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
