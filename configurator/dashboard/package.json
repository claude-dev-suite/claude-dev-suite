{
  "name": "@dev-suite/dashboard",
  "version": "1.12.0",
  "private": true,
  "type": "module",
  "description": "Dev-Suite Dashboard: visual project configuration and multi-agent orchestration for Claude Code.",
  "homepage": "https://github.com/claude-dev-suite/claude-dev-suite",
  "author": {
    "name": "Dev-Suite Team",
    "email": "claude-dev-suite@users.noreply.github.com",
    "url": "https://github.com/claude-dev-suite"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint src --max-warnings 0",
    "server:dev": "cd server && npm run dev",
    "server:build": "cd server && npm run build",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@types/dompurify": "^3.0.5",
    "clsx": "^2.1.0",
    "dompurify": "^3.4.7",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shiki": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.2",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "electron-playwright-helpers": "^2.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^24.1.3",
    "postcss": "^8.5.12",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.devsuite.dashboard",
    "productName": "Dev-Suite Dashboard",
    "directories": {
      "output": "dist-electron",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/dist/**/*",
      "server/package.json"
    ],
    "asarUnpack": [
      "electron/**/*",
      "server/**/*",
      "node/**/*"
    ],
    "extraResources": [
      {
        "from": "server/node_modules",
        "to": "app.asar.unpacked/server/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../agents",
        "to": "dev-suite/agents",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../skills",
        "to": "dev-suite/skills",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../mcp-servers",
        "to": "dev-suite/mcp-servers",
        "filter": [
          "**/dist/**",
          "**/package.json",
          "**/metadata.json",
          "skill-loader/skills/**"
        ]
      },
      {
        "from": "../../registry",
        "to": "dev-suite/registry",
        "filter": [
          "**/*.json"
        ]
      },
      {
        "from": "../../templates",
        "to": "dev-suite/templates",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../rules",
        "to": "dev-suite/rules",
        "filter": [
          "**/*.md"
        ]
      },
      {
        "from": "../../commands",
        "to": "dev-suite/commands",
        "filter": [
          "**/*.md"
        ]
      },
      {
        "from": "node-${arch}",
        "to": "node",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "claude-dev-suite",
      "repo": "claude-dev-suite",
      "private": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": true,
      "shortcutName": "Dev-Suite Dashboard"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "maintainer": "Dev-Suite Team <claude-dev-suite@users.noreply.github.com>",
      "synopsis": "Dev-Suite Dashboard: AI-powered development toolkit for Claude Code",
      "description": "Visual project configuration, MCP server orchestration, and multi-agent task management for Claude Code.",
      "artifactName": "dev-suite-dashboard-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    }
  }
}
