{
  "name": "@dev-suite/dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "server:dev": "cd server && npm run dev",
    "server:build": "cd server && npm run build",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.1.7",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "^40.1.0",
    "electron-builder": "^26.7.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^28.0.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "wait-on": "^7.2.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.devsuite.dashboard",
    "productName": "Dev-Suite Dashboard",
    "directories": {
      "output": "dist-electron",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/dist/**/*",
      "server/package.json"
    ],
    "asarUnpack": [
      "electron/**/*",
      "server/**/*",
      "node/**/*"
    ],
    "extraResources": [
      {
        "from": "server/node_modules",
        "to": "app.asar.unpacked/server/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../agents",
        "to": "dev-suite/agents",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../skills",
        "to": "dev-suite/skills",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../mcp-servers",
        "to": "dev-suite/mcp-servers",
        "filter": [
          "**/dist/**",
          "**/package.json",
          "**/metadata.json"
        ]
      },
      {
        "from": "../../registry",
        "to": "dev-suite/registry",
        "filter": [
          "**/*.json"
        ]
      },
      {
        "from": "node",
        "to": "node",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "claude-dev-suite",
      "repo": "claude-dev-suite",
      "private": false
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
