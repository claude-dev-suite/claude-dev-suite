@baseUrl = http://localhost:5555
@contentType = application/json

### Get users
GET {{baseUrl}}/users
    ?page=2
    &size=10
Accept: application/json

### Create user
# @name createUser
POST {{baseUrl}}/users HTTP/1.1
Content-Type: {{contentType}}

{
  "name": "{{$randomString 8}}",
  "id": "{{$uuid}}"
}

> {%
  client.global.set("id", response.body.id);
%}

###
// Upload a file body
PUT {{baseUrl}}/avatar
Content-Type: image/png

< ./avatar.png

###
{{baseUrl}}/ping
