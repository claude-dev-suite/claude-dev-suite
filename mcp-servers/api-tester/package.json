{
  "name": "@dev-suite/api-tester-server",
  "version": "2.0.0",
  "description": "MCP server for testing REST APIs with Postman/Insomnia import, test generation, and mock server",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --noEmit && node ../scripts/bundle.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "yaml": "^2.8.4",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
