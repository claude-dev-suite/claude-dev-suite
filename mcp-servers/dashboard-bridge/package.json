{
  "name": "@dev-suite/dashboard-bridge",
  "version": "2.0.0",
  "description": "MCP server for Claude Code orchestration with dashboard integration",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --noEmit && node ../scripts/bundle.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "claude",
    "dashboard",
    "dev-suite",
    "orchestrator"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "open": "^11.0.2",
    "ws": "^8.21.3",
    "@dev-suite/shared": "*"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/ws": "^8.5.13",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  }
}
