{
  "name": "@dev-suite/log-analyzer-server",
  "version": "2.2.0",
  "description": "MCP server for analyzing application logs - Spring Boot, Node.js, Python, Nginx, Apache, Kubernetes, Syslog",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --noEmit && node ../scripts/bundle.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "typescript": "^7.0.2",
    "tsx": "^4.22.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
