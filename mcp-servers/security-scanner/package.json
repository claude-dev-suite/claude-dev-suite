{
  "name": "@dev-suite/mcp-security-scanner",
  "version": "1.0.0",
  "description": "MCP server for security scanning - wraps npm audit, gitleaks, semgrep, trivy",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-security-scanner": "dist/index.js"
  },
  "scripts": {
    "build": "tsc --noEmit && node ../scripts/bundle.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "security",
    "scanner",
    "vulnerability",
    "secrets",
    "sast"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
