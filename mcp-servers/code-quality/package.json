{
  "name": "@dev-suite/code-quality",
  "version": "1.1.0",
  "description": "MCP server for code quality analysis - tree-sitter complexity, duplication, dead code, import graph, project linters, coverage, quality gate",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "gen:wasm": "node scripts/gen-wasm-assets.mjs",
    "build": "node scripts/gen-wasm-assets.mjs && tsc --noEmit && node ../scripts/bundle.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "node scripts/gen-wasm-assets.mjs && vitest run",
    "test:watch": "vitest",
    "typecheck": "node scripts/gen-wasm-assets.mjs && tsc --noEmit"
  },
  "dependencies": {
    "@dev-suite/shared": "*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "minimatch": "^10.2.6",
    "web-tree-sitter": "0.25.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^5.3.0"
  }
}
