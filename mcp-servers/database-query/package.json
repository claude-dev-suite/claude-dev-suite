{
  "name": "@dev-suite/database-query-server",
  "version": "2.3.0",
  "description": "MCP server for PostgreSQL, MySQL/MariaDB and SQLite queries, introspection and health",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --noEmit && node ../scripts/bundle.mjs",
    "start": "node dist/index.js",
    "start:env": "node start-with-env.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dev-suite/shared": "*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "mysql2": "^3.24.4",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/pg": "^8.23.1"
  }
}
