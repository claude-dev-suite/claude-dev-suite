{
  "name": "@dev-suite/api-explorer-server",
  "version": "2.3.0",
  "description": "MCP server to explore, lint and diff OpenAPI/Swagger, GraphQL, AsyncAPI and gRPC API descriptions",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --noEmit && node ../scripts/bundle.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dev-suite/shared": "*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "graphql": "^17.0.2",
    "protobufjs": "^8.8.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "keywords": [
    "mcp",
    "openapi",
    "swagger",
    "api-explorer",
    "api-documentation",
    "graphql",
    "asyncapi",
    "grpc"
  ],
  "author": "dev-suite",
  "license": "MIT"
}
