{
  "name": "@dev-suite/api-explorer-server",
  "version": "2.2.0",
  "description": "MCP server for fetching and exploring OpenAPI/Swagger schemas from multiple API endpoints",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --noEmit && node ../scripts/bundle.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.22.0",
    "yaml": "^2.8.4"
  },
  "keywords": [
    "mcp",
    "openapi",
    "swagger",
    "api-explorer",
    "api-documentation"
  ],
  "author": "dev-suite",
  "license": "MIT"
}
