{
  "name": "{{projectName}}-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "npm run routes:generate && vite",
    "build": "npm run routes:generate && tsc -b && vite build",
    "preview": "vite preview",
    "routes:generate": "npx @tanstack/router-cli generate",
    "routes:watch": "npx @tanstack/router-cli watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
