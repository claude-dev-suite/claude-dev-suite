{
  "name": "Python API",
  "description": "FastAPI with SQLAlchemy and PostgreSQL",
  "version": "1.0.0",
  "config": {
    "project": {
      "type": "api"
    },
    "stacks": {
      "frontend": {
        "framework": "none",
        "metaFramework": "none",
        "styling": "none",
        "stateManagement": "none",
        "componentLibrary": "none"
      },
      "backend": {
        "runtime": "python",
        "framework": "fastapi",
        "apiStyle": "rest"
      },
      "database": {
        "type": "postgresql",
        "orm": "sqlalchemy"
      },
      "infrastructure": {
        "containerization": "docker",
        "orchestration": "docker-compose",
        "cicd": "github-actions"
      },
      "testing": {
        "unit": "pytest",
        "e2e": "none",
        "coverageThreshold": 80
      }
    },
    "agents": {
      "enabled": [
        "architect",
        "code-reviewer",
        "python-expert",
        "fastapi-expert",
        "sqlalchemy-expert",
        "docker-expert",
        "security-expert"
      ],
      "config": {
        "fastapi-expert": {
          "skills": ["python", "fastapi", "rest-api", "pydantic", "openapi"]
        },
        "sqlalchemy-expert": {
          "skills": ["sqlalchemy", "postgresql", "database-design"]
        }
      }
    },
    "skills": {
      "global": ["python", "clean-code", "solid-principles", "security", "rest-api"]
    },
    "documentation": {
      "strategy": "hybrid",
      "levels": {
        "level0": { "enabled": true, "maxTokens": 500 },
        "level1": { "enabled": true, "maxTokens": 1000 },
        "level2": { "enabled": true, "maxTokens": 3000 },
        "level3": { "enabled": true, "preferLocal": true, "fallbackToLive": true }
      }
    },
    "hooks": {
      "formatOnSave": true,
      "lintOnSave": true,
      "typeCheckOnSave": false,
      "securityScan": true,
      "runAffectedTests": false
    },
    "mcp": {
      "enabled": ["documentation", "database-query", "api-tester"]
    }
  }
}
