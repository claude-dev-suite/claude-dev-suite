# Dev-Suite Environment Variables Template
# Copy to your project root as .env and customize

# ===========================================
# Documentation MCP Server (v2.1 - Git-only)
# ===========================================

# Knowledge Base Repository (Git on-demand mode)
# Default: https://github.com/claude-dev-suite/knowledge_base.git
# Set to use a custom/forked knowledge base repository
KB_REPO_URL=https://github.com/claude-dev-suite/knowledge_base.git

# Git branch to use (default: main)
KB_REPO_BRANCH=main

# Cache directory for downloaded docs (default: ./.kb-cache)
KB_CACHE_PATH=./.kb-cache

# Cache TTL in seconds (default: 7200 = 2 hours)
KB_CACHE_TTL=7200

# ===========================================
# Database Query MCP Server
# ===========================================

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mydb

# ===========================================
# API Explorer MCP Server
# ===========================================

# OpenAPI endpoints to explore
# JSON array: [{"alias":"api","url":"http://localhost:8080/v3/api-docs"}]
# Or simple format: api:http://localhost:8080/v3/api-docs
API_EXPLORER_ENDPOINTS=

# Cache TTL in seconds for API schemas (default: 300 = 5 min)
API_EXPLORER_CACHE_TTL=300

# ===========================================
# Project-Specific Settings
# ===========================================

# Project name (used in commit messages, logs, etc.)
PROJECT_NAME=my-project

# Development environment
NODE_ENV=development

# Frontend dev server
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# Backend API server
BACKEND_PORT=8080
BACKEND_URL=http://localhost:8080
